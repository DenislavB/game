; Engine configuration file.
; Godot 4 project — open this folder with Godot 4.3+ and press Play.

config_version=5

[application]

config/name="Emberfall"
config/description="A single-player low-poly RPG that recreates the feel of classic MMORPGs: slow, deliberate combat, grindy leveling, and large sparse zones."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

DB="*res://scripts/autoload/db.gd"
Events="*res://scripts/autoload/events.gd"
Game="*res://scripts/autoload/game.gd"
SFX="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

